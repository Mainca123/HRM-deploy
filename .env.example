# ==============================================================================
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (Copy file này thành .env và điền thông tin thật)
# ==============================================================================

# 1. Môi trường chạy và Múi giờ
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
TZ=Asia/Ho_Chi_Minh

# 2. Chuỗi kết nối TiDB Cloud / MySQL
ConnectionStrings__DefaultConnection=Server=gateway01.ap-southeast-1.prod.aws.tidbcloud.com;Port=4000;Database=hrm_db;Uid=YOUR_TIDB_USER;Pwd=YOUR_TIDB_PASSWORD;SslMode=VerifyFull;

# 3. Cấu hình bảo mật JWT (Tối thiểu 32 ký tự)
JwtSettings__SecretKey=CHANGE_THIS_TO_YOUR_SECURE_JWT_SECRET_KEY_AT_LEAST_32_CHARS
JwtSettings__Issuer=AttendanceManagement_API
JwtSettings__Audience=AttendanceManagement_Client
JwtSettings__ExpiryDays=7
